; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scraptronaut"
run/main_scene="res://scenes/station.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; Named "Audio", not "Sound": same name as `class_name Sound` makes the
; engine reject the script. See docs/arquitetura/som.md.
Audio="*res://scripts/sound.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; VT323, vector font with pixel look; antialiasing/subpixel off in the
; .import or it renders blurry. See docs/arquitetura/interface-e-camera.md.
theme/custom_font="res://assets/interface/vt323.ttf"

; Must be set explicitly — the engine default (16) is one of this font's
; uneven-stroke sizes. See docs/arquitetura/interface-e-camera.md.
theme/default_font_size=20

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
