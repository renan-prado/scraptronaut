{
  "name": "scraptronaut",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line shortcuts for the Godot project. Not a game dependency: nothing here is installed or bundled.",
  "scripts": {
    "play": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1 -Fullscreen",
    "play:window": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1 -Headless",
    "shot": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1 -Screenshot",
    "shot:long": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1 -Screenshot -Frames 180",
    "editor": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Start-Process 'C:/tools/godot/godot.exe' -ArgumentList '--editor','--path','.'\"",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1 -Script tools/testar_estacao.gd",
    "build:estacao": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1 -Script tools/construir_estacao.gd",
    "shot:planta": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1 -Screenshot -Output screenshots/planta.png -Zoom 0.16"
  }
}
