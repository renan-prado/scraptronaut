# Godot 4+ specific ignores
.godot/
/android/

# Screenshots generated by tools/run.ps1 -Screenshot
/screenshots/

# Node is only here for the npm run shortcuts
node_modules/

# Python bytecode from the tools/ scripts
__pycache__/

# Referencias visuais soltas em docs/: prints, colagens e PNGs de estudo.
# Os documentos de design continuam versionados — sao a fonte de verdade do
# projeto, e CLAUDE.md manda consultar antes de propor qualquer coisa.
# Ignorar "docs/" inteiro nao funcionaria: git nao desce num diretorio excluido,
# entao nem as negacoes abaixo seriam lidas.
docs/*
!docs/*.md
!docs/*.html
